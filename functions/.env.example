# Non-secret PayHero settings, read by `firebase deploy --only functions`.
# Copy to functions/.env. The API username and password are NOT set here:
#   firebase functions:secrets:set PAYHERO_API_USERNAME
#   firebase functions:secrets:set PAYHERO_API_PASSWORD
PAYHERO_CHANNEL_ID=your-payhero-channel-id
# Public HTTPS URL PayHero posts payment results to (the hosting rewrite in firebase.json).
PAYHERO_CALLBACK_URL=https://your-domain.example/api/payhero-callback
# Optional. Defaults to https://backend.payhero.co.ke/api/v2
# PAYHERO_API_BASE_URL=
