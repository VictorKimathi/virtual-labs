rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Subscription requests and payments are written only by Cloud Functions
    // (admin access), after the amount is set server-side and PayHero confirms
    // payment. Clients can never read or write them. Staff read them through
    // the Firebase console.
    match /schoolSubscriptions/{requestId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
